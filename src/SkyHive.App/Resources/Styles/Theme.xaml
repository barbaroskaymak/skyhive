<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <Color x:Key="BgColor">#0A0F1C</Color>
    <Color x:Key="PanelColor">#0F172A</Color>
    <Color x:Key="CardColor">#131D33</Color>
    <Color x:Key="StrokeColor">#1E2A44</Color>
    <Color x:Key="AccentColor">#22D3EE</Color>
    <Color x:Key="AccentDim">#0E3A47</Color>
    <Color x:Key="TextColor">#E2E8F0</Color>
    <Color x:Key="MutedColor">#7C8AA5</Color>
    <Color x:Key="GoodColor">#34D399</Color>
    <Color x:Key="WarnColor">#FBBF24</Color>
    <Color x:Key="DangerColor">#F43F5E</Color>

    <Style x:Key="Panel" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource PanelColor}" />
        <Setter Property="Stroke" Value="{StaticResource StrokeColor}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 14" />
        <Setter Property="Padding" Value="12" />
    </Style>
    <Style x:Key="SectionTitle" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource MutedColor}" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="CharacterSpacing" Value="1.6" />
    </Style>
    <Style x:Key="ActionButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource CardColor}" />
        <Setter Property="TextColor" Value="{StaticResource TextColor}" />
        <Setter Property="BorderColor" Value="{StaticResource StrokeColor}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="HeightRequest" Value="38" />
        <Setter Property="MinimumHeightRequest" Value="38" />
    </Style>
    <Style x:Key="ChipButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
        <Setter Property="HeightRequest" Value="28" />
        <Setter Property="MinimumHeightRequest" Value="28" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="10,0" />
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
        <Setter Property="BackgroundColor" Value="{StaticResource AccentColor}" />
        <Setter Property="TextColor" Value="#04131A" />
        <Setter Property="BorderColor" Value="{StaticResource AccentColor}" />
    </Style>
    <Style x:Key="StatValue" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource TextColor}" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="17" />
    </Style>
    <Style x:Key="StatLabel" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource MutedColor}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="CharacterSpacing" Value="1" />
    </Style>
    <Style x:Key="Field" TargetType="Entry">
        <Setter Property="BackgroundColor" Value="{StaticResource CardColor}" />
        <Setter Property="TextColor" Value="{StaticResource TextColor}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource MutedColor}" />
        <Setter Property="FontSize" Value="13" />
    </Style>
</ResourceDictionary>
